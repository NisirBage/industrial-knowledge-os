# LLM provider: "mock" (offline, no key needed) or "anthropic"
LLM_PROVIDER=mock
ANTHROPIC_API_KEY=
LLM_MODEL=claude-sonnet-5

# Qdrant (vector store). QDRANT_LOCAL_PATH is used automatically when
# QDRANT_URL is unreachable at startup (embedded local-file fallback mode).
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=ikios_chunks
QDRANT_LOCAL_PATH=./.qdrant_local

# Neo4j (knowledge graph). Falls back to an in-memory graph (not persisted
# across restarts) if unreachable at startup.
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=ikios_dev_password

# SQLite-backed stores (MVP substitute for Postgres). Each subsystem gets its
# own database file, matching each milestone's "independent subsystem" design.
METADATA_DB_URL=sqlite+aiosqlite:///./ikios_metadata.db
LEARNING_DB_URL=sqlite+aiosqlite:///./ikios_learning.db
EXPERIMENT_DB_URL=sqlite+aiosqlite:///./ikios_experiments.db
ML_REGISTRY_DB_URL=sqlite+aiosqlite:///./ikios_ml_registry.db
ML_MODELS_DIR=./.ml_models

# Embeddings
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5

# Entity extraction: GLiNER primary (zero-shot NER), regex always runs alongside
# it for structured codes. Falls back to regex-only if the model can't load.
GLINER_MODEL=urchade/gliner_mediumv2.1
GLINER_THRESHOLD=0.4
ENABLE_LLM_ENTITY_VALIDATION=false

# Cross-encoder reranker. cross-encoder/ms-marco-MiniLM-L-6-v2 is fast on CPU;
# BAAI/bge-reranker-large is the production-quality option if hardware allows.
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2

CORS_ORIGINS=http://localhost:5173

# Reject uploads over this size before buffering them (v1.0.1 hardening).
MAX_UPLOAD_SIZE_MB=25
